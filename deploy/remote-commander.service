[Unit]
Description=Remote Commander MCP agent
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/remote-commander
EnvironmentFile=%h/.config/remote-commander/agent.env
ExecStart=%h/remote-commander/.venv/bin/remote-commander agent --config %h/.config/remote-commander/agent.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
